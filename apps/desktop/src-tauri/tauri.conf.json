{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSRS Clicker",
  "version": "0.1.0",
  "identifier": "com.osrsclicker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:sidecar",
    "frontendDist": "../../web-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OSRS Clicker",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/osrs-clicker-service"
    ]
  }
}
