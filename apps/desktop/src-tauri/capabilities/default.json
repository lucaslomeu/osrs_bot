{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the OSRS Clicker desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/osrs-clicker-service",
          "sidecar": true,
          "args": [
            "--port",
            {
              "validator": "\\d+"
            }
          ]
        }
      ]
    }
  ]
}
